
scale_record = record {
    id: i32;
    name: string;
    intervals: array<i32>;
}

chord_record = record {
    id: i32;
    name: string;
    semitones: array<i32>;
}

guitar_record = record {
    id: i32;
    name: string;
    number_of_frets: i32;
}

sguitar_DAO = interface + c {
    static create_sguitar_dao(path: string): sguitar_DAO;
}

scale_DAO = interface +c {
    static create_scale_dao(database: sguitar_DAO): scale_DAO;
    get_scales(): array<scale_record>;
    add_scale(scale: scale_record): i32;
    update_scale(scale: scale_record);
    delete_scale(id: i32);
}

chord_DAO = interface +c {
    static create_chord_dao(database: sguitar_DAO): chord_DAO;
    get_chords(): array<chord_record>;
    add_chord(chord: chord_record): i32;
    update_chord(chord: chord_record);
    delete_chord(id: i32);
}

guitar_DAO = interface +c {
    static create_guitar_dao(database: sguitar_DAO): guitar_DAO;
    get_guitars(): array<guitar_record>;
    add_guitar(guitar: guitar_record);
    update_guitar(guitar: guitar_record): i32;
    delete_guitar(id: i32);
}
