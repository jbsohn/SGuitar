
scale_record = record {
    id: i32;
    name: string;
    semitones: array<i32>;
}

chord_record = record {
    id: i32;
    name: string;
    intervals: array<i32>;
}

guitar_string_record = record {
    id: i32;
    guitar_id: i32;
    string_number: i32;
    start_note: string;
    octave: i32;
}

guitar_string_adjustment_record = record {
    id: i32;
    guitar_adjustment_id: i32;
    string_number: i32;
    step: i32;
}

guitar_adjustment_record = record {
    id: i32;
    guitar_id: i32;
    name: string;
    guitar_string_adjustments: array<guitar_string_adjustment_record>;
}

guitar_record = record {
    id: i32;
    name: string;
    number_of_frets: i32;
    guitar_strings: array<guitar_string_record>;
    guitar_adjustments: array<guitar_adjustment_record>;
}

SGuitar_database = interface + c {
    static create_sguitar_database(path: string): SGuitar_database;
}

scale_DAO = interface +c {
    static create_scale_dao(database: SGuitar_database): scale_DAO;
    get_scales(): array<scale_record>;
    add_scale(scale: scale_record): i32;
    update_scale(scale: scale_record);
    delete_scale(id: i32);
}

chord_DAO = interface +c {
    static create_chord_dao(database: SGuitar_database): chord_DAO;
    get_chords(): array<chord_record>;
    add_chord(chord: chord_record): i32;
    update_chord(chord: chord_record);
    delete_chord(id: i32);
}

guitar_DAO = interface +c {
    static create_guitar_dao(database: SGuitar_database): guitar_DAO;
    get_guitars(): array<guitar_record>;
    add_guitar(guitar: guitar_record);
    update_guitar(guitar: guitar_record): i32;
    delete_guitar(id: i32);
}
