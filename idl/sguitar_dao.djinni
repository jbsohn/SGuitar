
scale_record = record {
    id: optional<i32>;
    name: string;
    semitones: array<i32>;
}

chord_record = record {
    id: optional<i32>;
    name: string;
    intervals: array<i32>;
}

guitar_string_record = record {
    id: optional<i32>;
    guitar_id: i32;
    string_number: i32;
    start_note: string;
    octave: i32;
}

guitar_string_adjustment_record = record {
    id: optional<i32>;
    guitar_adjustment_id: i32;
    string_number: i32;
    step: i32;
}

guitar_adjustment_record = record {
    id: optional<i32>;
    guitar_id: i32;
    name: string;
    position: i32;
    order: i32;
    guitar_string_adjustments: array<guitar_string_adjustment_record>;
}

guitar_record = record {
    id: optional<i32>;
    name: string;
    number_of_frets: i32;
    fret_markers: array<i32>;
    type: i32;
    guitar_strings: array<guitar_string_record>;
    guitar_adjustments: array<guitar_adjustment_record>;
}

SGDatabase_connection = interface + c {
    static create_SGDatabase_connection(path: string): SGDatabase_connection;
}

scale_DAO = interface +c {
    static create_scale_dao(database: SGDatabase_connection): scale_DAO;
    get_scales(): array<scale_record>;
    add_scale(scale: scale_record): optional<i32>;
    update_scale(scale: scale_record): bool;
    delete_scale(id: i32): bool;
}

chord_DAO = interface +c {
    static create_chord_dao(database: SGDatabase_connection): chord_DAO;
    get_chords(): array<chord_record>;
    add_chord(chord: chord_record): optional<i32>;
    update_chord(chord: chord_record): bool;
    delete_chord(id: i32): bool;
}

guitar_DAO = interface +c {
    static create_guitar_dao(database: SGDatabase_connection): guitar_DAO;
    get_guitars(): array<guitar_record>;
    add_guitar(guitar: guitar_record): optional<i32>;
    update_guitar(guitar: guitar_record): bool;
    delete_guitar(id: i32): bool;
}
